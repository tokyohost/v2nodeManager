<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.V2NodeVlessMapper">

    <resultMap type="NodeVo" id="V2VlessResult">
        <result property="name"    column="name"    />
        <result property="currentDns"    column="currentDns"    />
        <result property="nodeId"    column="nodeId"    />
    </resultMap>

    <sql id="selectV2VlessNodeVo">
        select id as nodeId,name,host as currentDns from v2_server_vless
    </sql>

    <select id="queryList" resultMap="V2VlessResult">
        <include refid="selectV2VlessNodeVo"/>
        <where>

        </where>
    </select>
</mapper>
